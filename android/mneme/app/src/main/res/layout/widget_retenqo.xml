<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/widget_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/widget_summary_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            android:text="Project Nexus: export fix before Friday; revised build Thursday."
            android:textColor="#EAF2EF"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_arrow"
            android:layout_width="34dp"
            android:layout_height="30dp"
            android:layout_gravity="end|top"
            android:background="@drawable/widget_arrow_background"
            android:gravity="center"
            android:text="›"
            android:textColor="#10231D"
            android:textSize="23sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_summary_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Tomorrow 3 PM: review the build and prepare graphs."
        android:textColor="#EAF2EF"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_summary_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="After testing: send the revised proposal to the client."
        android:textColor="#EAF2EF"
        android:textSize="15sp" />

</LinearLayout>
